{
  "manifest_version": 2,
  "name": "YouTube Limpio",
  "version": "1.0.1",
  "description": "Oculta 'Más relevantes' en Suscripciones y las secciones de noticias, Jugables y promociones de miembros en Inicio.",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-limpio@josh.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}